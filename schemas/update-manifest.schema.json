{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rainyflash/token-poker/blob/main/schemas/update-manifest.schema.json",
  "title": "Token Poker stable update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "version",
    "tag",
    "repository",
    "release_url",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channel": {
      "const": "stable"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "release_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "name",
        "bytes",
        "sha256",
        "download_url"
      ],
      "properties": {
        "target": {
          "enum": ["windows-x64"]
        },
        "name": {
          "type": "string",
          "pattern": "^token-poker-plugin-v.+-windows-x64\\.zip$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "download_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        }
      }
    }
  }
}
