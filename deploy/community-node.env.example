# Copy this file to deploy/community-node.env and replace the example host.
# Addresses identify the public endpoint after Docker port forwarding; they do
# not include the node PeerId.
TOKEN_POKER_EXTERNAL_TCP_ADDRESS=/dns4/poker.example.com/tcp/4001
TOKEN_POKER_EXTERNAL_QUIC_ADDRESS=/dns4/poker.example.com/udp/4001/quic-v1
